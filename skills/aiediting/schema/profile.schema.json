{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/alexfisenkov/AIEditing/skills/aiediting/schema/profile.schema.json",
  "title": "AIEditing format profile",
  "description": "Answers of the interview for one editing format; data only, no secrets.",
  "type": "object",
  "required": ["format", "skill_name", "language", "asr", "steps", "output_dir"],
  "properties": {
    "format": {"type": "string", "minLength": 1},
    "skill_name": {
      "type": "string",
      "minLength": 1,
      "description": "Folder name under ~/.agents/skills/: no separators, no leading or trailing dot (rules out '.', '..', hidden names).",
      "pattern": "^[^./\\\\:*?\"<>|\\s]([^/\\\\:*?\"<>|\\s]*[^./\\\\:*?\"<>|\\s])?$"
    },
    "language": {"type": "string", "minLength": 2},
    "asr": {"$ref": "#/definitions/asr"},
    "steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "params": {
      "type": "object",
      "properties": {"animations": {"$ref": "#/definitions/animations"}}
    },
    "approval": {"enum": ["plan", "parts"]},
    "design": {"type": "string"},
    "taste": {"type": "array", "items": {"$ref": "#/definitions/taste"}},
    "output_dir": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true,
  "definitions": {
    "asr": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {"enum": ["whispercpp", "scribe", "openai_compat", "command"]},
        "language": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "base_url": {"type": ["string", "null"], "pattern": "^https?://"},
        "api_key_env": {"type": ["string", "null"], "pattern": "^[A-Z_][A-Z0-9_]*$"},
        "key_file": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Path to a .env the person already keeps the key in (~ allowed); the key is read from it at run time under api_key_env and never copied."
        },
        "command": {"type": ["array", "null"], "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "animations": {
      "type": "object",
      "description": "Animated inserts (step `animations`, HyperFrames): at most one per `every` seconds; `seconds` fixes their length (else 4–8 s by the number of points).",
      "properties": {
        "every": {"type": "number", "minimum": 30, "maximum": 60},
        "seconds": {"type": "number", "minimum": 2, "maximum": 15}
      }
    },
    "taste": {
      "type": "object",
      "required": ["date", "video", "note"],
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}"},
        "video": {"type": "string"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
