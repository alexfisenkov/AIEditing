  "license": "Токены и правила — MIT (как весь репозиторий). Шрифты в fonts/ — SIL Open Font License 1.1, тексты лицензий рядом.",
  "color": {
    "paper": "#F4F5F6",
    "white": "#FFFFFF",
    "ink": "#181A1C",
    "muted": "#55585E",
    "faint": "#888B91",
    "line": "#E3E4E7",
    "graphite": "#171717",
    "graphite-soft": "#202123",
    "night": "#0E0E10",
    "silver": "#C7C9CC",
    "silver-light": "#ECEDEF",
    "ok": "#1F8A5B"
  },
  "gradient": {
    "chrome": ["#FFFFFF", "#E0E2E5", "#A9ACB1", "#EEF0F2"],
    "dark-surface": ["#202123", "#0E0E10"]
  },
  "font": {
    "text": {"family": "Onest", "file": "fonts/Onest.ttf", "license": "OFL-1.1",
             "source": "https://github.com/googlefonts/onest"},
    "display": {"family": "Unbounded", "file": "fonts/Unbounded.ttf", "license": "OFL-1.1",
                "source": "https://github.com/googlefonts/unbounded", "fallback": "text"},
    "mono": {"family": "JetBrains Mono", "file": "fonts/JetBrainsMono.ttf", "license": "OFL-1.1",
             "source": "https://github.com/JetBrains/JetBrainsMono"}
  },
  "radius": {"block": 26, "card": 22, "inner": 15, "pill": 999},
  "overlay": {
    "color": {"white": "#FFFFFF", "muted": "#C7C9CC", "faint": "#8A8D92", "graphite": "#171717", "graphiteSoft": "#202123",
              "deep": "#0E0E10", "card": "#1B1C1F", "silver": "#C7C9CC", "silverLight": "#ECEDEF", "paper": "#F4F5F6",
              "ink": "#181A1C", "line": "rgba(255,255,255,.14)", "ok": "#1F8A5B"},
    "chrome": "linear-gradient(180deg,#FFFFFF 0%,#E0E2E5 40%,#A9ACB1 62%,#EEF0F2 100%)",
    "bg": "linear-gradient(165deg,#202123 0%,#0E0E10 100%)",
    "glass": "linear-gradient(165deg,rgba(32,33,35,.92),rgba(14,14,16,.94))",
    "hair": "linear-gradient(90deg,transparent,rgba(199,201,204,.55),transparent)",
    "rim": "0 0 0 1px rgba(199,201,204,.2), inset 0 1px 0 rgba(255,255,255,.08)",
    "shadow": "0 40px 90px rgba(0,0,0,.55)",
    "shine": "linear-gradient(100deg,#9A9DA2 0%,#E0E2E5 30%,#FFFFFF 42%,#E0E2E5 54%,#9A9DA2 100%)",
    "radius": {"block": 26, "card": 22, "inner": 15, "pill": 999}
  },
  "motion": {"ease": "cubic-bezier(0.16,1,0.3,1)", "fade_s": 0.3, "appear": "из лёгкого блюра и прозрачности"},
  "video": {
    "units": "размеры — доли высоты кадра (size, margin, radius) и ширины (max_width); у карточки и вставки — доли короткой стороны кадра, а max_width — длинной; alpha 0..1",
    "safe_zone_vertical": {"top": 0.12, "bottom": 0.2, "side": 0.06},
    "chapter": {
      "font": "text", "weight": "Medium", "size": 0.028, "pad_x": 0.85, "pad_y": 0.42,
      "bg": "graphite", "bg_alpha": 0.82, "fg": "white", "line": "silver", "line_alpha": 0.28,
      "radius": "pill", "where": "bottom", "margin": 0.05, "max_width": 0.6,
      "seconds": 3.0, "fade": 0.3
    },
    "caption": {
      "font": "text", "weight": "SemiBold", "size": 0.044, "pad_x": 0.5, "pad_y": 0.22,
      "bg": "graphite", "bg_alpha": 0.6, "fg": "white", "radius": 0.012, "align": "center",
      "where": "bottom", "margin": 0.08, "max_width": 0.8, "max_lines": 2
    },
    "card": {
      "font": "display", "weight": "Bold", "size": 0.036, "body_font": "text", "body_weight": "Regular",
      "body_size": 0.026, "pad_x": 0.9, "pad_y": 0.75, "bg": "graphite-soft", "bg_alpha": 0.8,
      "fg": "white", "body_fg": "silver", "line": "silver", "line_alpha": 0.22, "radius": 0.02,
      "where": "top-left", "margin": 0.045, "max_width": 0.34, "seconds": 5.0, "fade": 0.4
    },
    "animation": {
      "font": "display", "weight": "Bold", "size": 0.034, "body_font": "text", "body_weight": "Regular",
      "mono_font": "mono", "body_size": 0.026, "number_size": 0.1, "row": 1.9, "pad": 0.028,
      "bg": "graphite-soft", "bg_alpha": 0.82, "fg": "white", "body_fg": "silver", "line": "silver",
      "line_alpha": 0.22, "radius": 0.02, "where": "top-left", "margin": 0.045, "max_width": 0.3,
      "enter": 0.5, "exit": 0.3, "stagger": 0.12, "fps": 30,
      "templates": "animations/: files «файлы», steps «шаги», list «список», number «число» — HTML для HyperFrames"
    },
    "band": {
      "side": 0.06, "gap": 0.0105,
      "headline": {"font": "display", "weight": "Bold", "size": 0.044, "min_size": 0.024, "line": 1.16, "max_lines": 4,
                   "fill": "chrome"},
      "cta": {"font": "text", "weight": "SemiBold", "lead_weight": "Medium", "size": 0.024, "line": 1.42, "pad_x": 1.1,
              "pad_y": 0.5, "fg": "white", "lead_fg": "silver", "accent": "chrome", "accent_font": "display",
              "accent_weight": "Bold", "accent_scale": 0.92, "bg": "graphite-soft", "line_color": "silver",
              "line_alpha": 0.22, "radius": 0.014}
    },
    "teaser": {
      "ring": "silver", "ring_alpha": 0.55, "icon": "chrome", "icon_size": 0.3, "track": "white",
      "track_alpha": 0.24, "bar": "chrome", "text": "white", "font": "mono", "weight": "Medium", "text_size": 0.026
    },
    "variants": {
      "chapter": [
        {"name": "графитовая капсула снизу"},
        {"name": "графит слева, строже", "where": "bottom-left", "radius": 0.008, "line_alpha": 0.5},
        {"name": "серебро снизу", "bg": "silver-light", "bg_alpha": 0.92, "fg": "ink", "line": "silver"}
      ],
      "caption": [
        {"name": "тёмная подложка"},
        {"name": "без подложки, обводка", "bg_alpha": 0.0, "stroke": 0.12, "stroke_color": "night"},
        {"name": "серебряная подложка", "bg": "silver-light", "bg_alpha": 0.9, "fg": "ink"}
      ],
      "card": [
        {"name": "в углу напротив лица"},
        {"name": "сверху по центру", "where": "top"},
        {"name": "по центру, крупнее", "where": "center", "max_width": 0.46, "size": 0.044, "body_size": 0.03}
      ]
    }
  },
  "rules": [
    "только цвета из color; единственный цветной — ok, и то для статуса «готово»",
    "только шрифты из font; без файла display берётся text потолще",
    "без эмодзи, стоковых иконок, цветных плашек и цветных градиентов",
    "плашка главы — маленькая, тёмная, снизу, по ширине текста, 2–4 секунды",
    "графика при показе экрана — мелко, на затемнённом фоне, в углу напротив лица, сверху или по центру",
    "анимированная вставка — там же, где карточка, вместо неё; вход из блюра, пункты по одному, без звука, без цвета"
  ]
}
